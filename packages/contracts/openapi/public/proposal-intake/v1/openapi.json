{
  "openapi": "3.1.0",
  "info": {
    "title": "CreditOS Proposal Intake Public API Structural Contract",
    "version": "v1",
    "description": "Contrato estrutural mínimo para validar organização e governança. Não é o contrato final de produto."
  },
  "x-creditos": {
    "owner": "Proposal Intake",
    "compatibility": "backward-compatible",
    "breakingChangePolicy": "new-major-version-required"
  },
  "paths": {
    "/v1/proposals": {
      "post": {
        "summary": "Placeholder estrutural de submissão de proposta",
        "operationId": "submitProposalStructuralPlaceholder",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Proposta aceita para processamento assíncrono"
          },
          "400": {
            "description": "Requisição inválida ou fora do schema aprovado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de idempotência ou estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
