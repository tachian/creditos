{
  "openapi": "3.1.0",
  "info": {
    "title": "CreditOS Decision Public API Contract",
    "version": "v1",
    "description": "Contrato público versionado para consulta minimizada de decisão de crédito por proposta."
  },
  "x-creditos": {
    "owner": "Decision",
    "compatibility": "backward-compatible",
    "breakingChangePolicy": "new-major-version-required",
    "referencePolicy": "Somente proposal_id é referência permitida nesta versão; external_proposal_id e customer_reference exigem contrato futuro."
  },
  "paths": {
    "/v1/proposals/{proposal_id}/decision": {
      "get": {
        "summary": "Consulta pública de decisão por proposta v1",
        "operationId": "getDecisionByProposal",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9_.-]{2,159}$"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decisão encontrada para o tenant autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida ou referência fora do contrato aprovado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Decisão não disponível; usado também para inexistente, cross-tenant ou permissão insuficiente sem revelar existência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionQueryResponse": {
        "type": "object",
        "required": [
          "contract_version",
          "proposal_id",
          "status",
          "message",
          "correlation_id"
        ],
        "properties": {
          "contract_version": {
            "const": "v1",
            "description": "Versão pública do contrato de decisão/status."
          },
          "proposal_id": {
            "type": "string",
            "description": "Identificador técnico da proposta informado na consulta."
          },
          "decision_id": {
            "type": "string",
            "description": "Identificador da decisão quando uma decisão final/controlada já existe; ausente para status pré-decisão."
          },
          "status": {
            "type": "string",
            "description": "Estado público versionado da análise/decisão. submitted/processing indicam que ainda não há decisão final; completed/requires_input/unable_to_decide indicam decisão controlada disponível.",
            "enum": [
              "submitted",
              "processing",
              "completed",
              "requires_input",
              "unable_to_decide"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "approve_with_changes",
              "request_more_data",
              "unable_to_decide"
            ],
            "description": "Resultado final versionado quando disponível; ausente para status pré-decisão."
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "description": "Instante UTC da decisão quando disponível; ausente para status pré-decisão."
          },
          "product_type": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Produto associado por projeção governada ou decisão."
          },
          "channel": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Canal associado por projeção governada ou decisão."
          },
          "correlation_id": {
            "type": "string",
            "description": "Correlation ID recebido na requisição para rastreabilidade."
          },
          "policy": {
            "$ref": "#/components/schemas/DecisionPolicyMetadata",
            "description": "Metadados de política apenas quando uma decisão final/controlada existe."
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "description": "Reason codes públicos visíveis ao cliente quando uma decisão existe; vazio para status pré-decisão."
          },
          "factors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExplainableFactor"
            },
            "description": "Fatores explicáveis visíveis ao cliente quando uma decisão existe; vazio para status pré-decisão."
          },
          "approved_terms": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ApprovedTerms"
              },
              {
                "type": "null"
              }
            ],
            "description": "Termos aprovados quando aplicável; ausente para rejeição, status pré-decisão ou decisão sem termos aprovados."
          },
          "message": {
            "type": "string",
            "description": "Mensagem pública segura, sem payload bruto, dado pessoal, regra interna ou detalhe técnico proprietário.",
            "enum": [
              "análise recebida",
              "análise em processamento",
              "decisão aprovada",
              "decisão recusada",
              "decisão aprovada com alterações",
              "dados adicionais necessários",
              "decisão inconclusiva"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Resposta pública minimizada para status de análise ou decisão final da proposta no tenant autenticado.",
        "oneOf": [
          {
            "title": "Status pré-decisão",
            "required": [
              "contract_version",
              "proposal_id",
              "status",
              "message",
              "correlation_id",
              "product_type",
              "channel"
            ],
            "properties": {
              "status": {
                "enum": [
                  "submitted",
                  "processing"
                ]
              },
              "message": {
                "enum": [
                  "análise recebida",
                  "análise em processamento"
                ]
              },
              "reason_codes": {
                "maxItems": 0
              },
              "factors": {
                "maxItems": 0
              }
            },
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "submitted"
                  },
                  "message": {
                    "const": "análise recebida"
                  }
                }
              },
              {
                "properties": {
                  "status": {
                    "const": "processing"
                  },
                  "message": {
                    "const": "análise em processamento"
                  }
                }
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "decision_id"
                  ]
                },
                {
                  "required": [
                    "outcome"
                  ]
                },
                {
                  "required": [
                    "decided_at"
                  ]
                },
                {
                  "required": [
                    "policy"
                  ]
                },
                {
                  "required": [
                    "approved_terms"
                  ]
                }
              ]
            }
          },
          {
            "title": "Decisão aprovada",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors",
              "approved_terms"
            ],
            "properties": {
              "status": {
                "const": "completed"
              },
              "outcome": {
                "const": "approve"
              },
              "message": {
                "const": "decisão aprovada"
              }
            }
          },
          {
            "title": "Decisão recusada",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors"
            ],
            "properties": {
              "status": {
                "const": "completed"
              },
              "outcome": {
                "const": "reject"
              },
              "message": {
                "const": "decisão recusada"
              }
            },
            "not": {
              "required": [
                "approved_terms"
              ]
            }
          },
          {
            "title": "Decisão aprovada com alterações",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors",
              "approved_terms"
            ],
            "properties": {
              "status": {
                "const": "completed"
              },
              "outcome": {
                "const": "approve_with_changes"
              },
              "message": {
                "const": "decisão aprovada com alterações"
              }
            }
          },
          {
            "title": "Dados adicionais necessários",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors"
            ],
            "properties": {
              "status": {
                "const": "requires_input"
              },
              "outcome": {
                "const": "request_more_data"
              },
              "message": {
                "const": "dados adicionais necessários"
              }
            },
            "not": {
              "required": [
                "approved_terms"
              ]
            }
          },
          {
            "title": "Decisão inconclusiva",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors"
            ],
            "properties": {
              "status": {
                "const": "unable_to_decide"
              },
              "outcome": {
                "const": "unable_to_decide"
              },
              "message": {
                "const": "decisão inconclusiva"
              }
            },
            "not": {
              "required": [
                "approved_terms"
              ]
            }
          }
        ]
      },
      "DecisionPolicyMetadata": {
        "type": "object",
        "required": [
          "policy_id",
          "policy_version_id",
          "policy_revision",
          "reason_code_catalog_version_id"
        ],
        "properties": {
          "policy_id": {
            "type": "string"
          },
          "policy_version_id": {
            "type": "string"
          },
          "policy_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code_catalog_version_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReasonCode": {
        "type": "object",
        "required": [
          "code",
          "title",
          "description",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ExplainableFactor": {
        "type": "object",
        "required": [
          "factor_id",
          "field",
          "title",
          "description",
          "required"
        ],
        "properties": {
          "factor_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ApprovedTerms": {
        "type": "object",
        "required": [
          "approved_amount_units",
          "approved_installments",
          "approved_term_days"
        ],
        "properties": {
          "approved_amount_units": {
            "type": "integer",
            "minimum": 0
          },
          "approved_installments": {
            "type": "integer",
            "minimum": 0
          },
          "approved_term_days": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "error_code": {
            "type": "string",
            "description": "Código público versionado, seguro e estável. decision_not_available também cobre inexistente, cross-tenant e permissão insuficiente quando a existência não puder ser revelada.",
            "enum": [
              "invalid_request",
              "decision_not_available",
              "decision_query_failed"
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensagem pública segura sem payload bruto ou detalhe técnico interno."
          },
          "correlation_id": {
            "type": "string",
            "description": "Correlation ID recebido na requisição para rastreabilidade."
          }
        },
        "additionalProperties": false,
        "description": "Erro público versionado e seguro para consulta de decisão/status."
      }
    }
  }
}
