{
  "openapi": "3.1.0",
  "info": {
    "title": "CreditOS Decision Public API Contract",
    "version": "v1",
    "description": "Contrato público versionado para consulta minimizada de decisão de crédito por proposta."
  },
  "x-creditos": {
    "owner": "Decision",
    "compatibility": "backward-compatible",
    "breakingChangePolicy": "new-major-version-required",
    "referencePolicy": "Somente proposal_id é referência permitida nesta versão; external_proposal_id e customer_reference exigem contrato futuro."
  },
  "paths": {
    "/v1/proposals/{proposal_id}/decision": {
      "get": {
        "summary": "Consulta pública de decisão por proposta v1",
        "operationId": "getDecisionByProposal",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9_.-]{2,159}$"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decisão encontrada para o tenant autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida ou referência fora do contrato aprovado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Decisão não disponível; usado também para inexistente, cross-tenant ou permissão insuficiente sem revelar existência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionQueryResponse": {
        "type": "object",
        "required": [
          "contract_version",
          "proposal_id",
          "decision_id",
          "status",
          "outcome",
          "decided_at",
          "product_type",
          "channel",
          "correlation_id",
          "policy",
          "reason_codes",
          "factors"
        ],
        "properties": {
          "contract_version": {
            "const": "v1"
          },
          "proposal_id": {
            "type": "string"
          },
          "decision_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "requires_input",
              "unable_to_decide"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "approve_with_changes",
              "request_more_data",
              "unable_to_decide"
            ]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "product_type": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/DecisionPolicyMetadata"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            }
          },
          "factors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExplainableFactor"
            }
          },
          "approved_terms": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ApprovedTerms"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "DecisionPolicyMetadata": {
        "type": "object",
        "required": [
          "policy_id",
          "policy_version_id",
          "policy_revision",
          "reason_code_catalog_version_id"
        ],
        "properties": {
          "policy_id": {
            "type": "string"
          },
          "policy_version_id": {
            "type": "string"
          },
          "policy_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code_catalog_version_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReasonCode": {
        "type": "object",
        "required": [
          "code",
          "title",
          "description",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ExplainableFactor": {
        "type": "object",
        "required": [
          "factor_id",
          "field",
          "title",
          "description",
          "required"
        ],
        "properties": {
          "factor_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ApprovedTerms": {
        "type": "object",
        "required": [
          "approved_amount_units",
          "approved_installments",
          "approved_term_days"
        ],
        "properties": {
          "approved_amount_units": {
            "type": "integer",
            "minimum": 0
          },
          "approved_installments": {
            "type": "integer",
            "minimum": 0
          },
          "approved_term_days": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
