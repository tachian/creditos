{
  "openapi": "3.1.0",
  "info": {
    "title": "CreditOS Decision Public API Contract",
    "version": "v1",
    "description": "Contrato público versionado para consulta minimizada de decisão de crédito por proposta."
  },
  "x-creditos": {
    "owner": "Decision",
    "compatibility": "backward-compatible",
    "breakingChangePolicy": "new-major-version-required",
    "referencePolicy": "Somente proposal_id é referência permitida nesta versão; external_proposal_id e customer_reference exigem contrato futuro."
  },
  "paths": {
    "/v1/proposals/{proposal_id}/decision": {
      "get": {
        "summary": "Consulta pública de decisão por proposta v1",
        "operationId": "getDecisionByProposal",
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[a-z0-9][a-z0-9_.-]{2,159}$"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decisão encontrada para o tenant autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionQueryResponse"
                },
                "examples": {
                  "DecisionSubmittedExample": {
                    "$ref": "#/components/examples/DecisionSubmittedExample"
                  },
                  "DecisionApprovedExample": {
                    "$ref": "#/components/examples/DecisionApprovedExample"
                  },
                  "DecisionRejectedExample": {
                    "$ref": "#/components/examples/DecisionRejectedExample"
                  },
                  "DecisionUnableToDecideExample": {
                    "$ref": "#/components/examples/DecisionUnableToDecideExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida ou referência fora do contrato aprovado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "DecisionInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/DecisionInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "DecisionInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/DecisionInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Decisão não disponível; usado também para inexistente, cross-tenant ou permissão insuficiente sem revelar existência",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "DecisionNotAvailableErrorExample": {
                    "$ref": "#/components/examples/DecisionNotAvailableErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "DecisionQueryFailedErrorExample": {
                    "$ref": "#/components/examples/DecisionQueryFailedErrorExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionQueryResponse": {
        "type": "object",
        "required": [
          "contract_version",
          "proposal_id",
          "status",
          "message",
          "correlation_id"
        ],
        "properties": {
          "contract_version": {
            "const": "v1",
            "description": "Versão pública do contrato de decisão/status."
          },
          "proposal_id": {
            "type": "string",
            "description": "Identificador técnico da proposta informado na consulta."
          },
          "decision_id": {
            "type": "string",
            "description": "Identificador da decisão quando uma decisão final/controlada já existe; ausente para status pré-decisão."
          },
          "status": {
            "type": "string",
            "description": "Estado público versionado da análise/decisão. submitted/processing indicam que ainda não há decisão final; completed/requires_input/unable_to_decide indicam decisão controlada disponível.",
            "enum": [
              "submitted",
              "processing",
              "completed",
              "requires_input",
              "unable_to_decide"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "approve_with_changes",
              "request_more_data",
              "unable_to_decide"
            ],
            "description": "Resultado final versionado quando disponível; ausente para status pré-decisão."
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "description": "Instante UTC da decisão quando disponível; ausente para status pré-decisão."
          },
          "product_type": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Produto associado por projeção governada ou decisão."
          },
          "channel": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Canal associado por projeção governada ou decisão."
          },
          "correlation_id": {
            "type": "string",
            "description": "Correlation ID recebido na requisição para rastreabilidade."
          },
          "policy": {
            "$ref": "#/components/schemas/DecisionPolicyMetadata",
            "description": "Metadados de política apenas quando uma decisão final/controlada existe."
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "description": "Reason codes públicos visíveis ao cliente quando uma decisão existe; vazio para status pré-decisão."
          },
          "factors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExplainableFactor"
            },
            "description": "Fatores explicáveis visíveis ao cliente quando uma decisão existe; vazio para status pré-decisão."
          },
          "approved_terms": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ApprovedTerms"
              },
              {
                "type": "null"
              }
            ],
            "description": "Termos aprovados quando aplicável; ausente para rejeição, status pré-decisão ou decisão sem termos aprovados."
          },
          "message": {
            "type": "string",
            "description": "Mensagem pública segura, sem payload bruto, dado pessoal, regra interna ou detalhe técnico proprietário.",
            "enum": [
              "análise recebida",
              "análise em processamento",
              "decisão aprovada",
              "decisão recusada",
              "decisão aprovada com alterações",
              "dados adicionais necessários",
              "decisão inconclusiva"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Resposta pública minimizada para status de análise ou decisão final da proposta no tenant autenticado.",
        "oneOf": [
          {
            "title": "Status pré-decisão",
            "required": [
              "contract_version",
              "proposal_id",
              "status",
              "message",
              "correlation_id",
              "product_type",
              "channel"
            ],
            "properties": {
              "status": {
                "enum": [
                  "submitted",
                  "processing"
                ]
              },
              "message": {
                "enum": [
                  "análise recebida",
                  "análise em processamento"
                ]
              },
              "reason_codes": {
                "maxItems": 0
              },
              "factors": {
                "maxItems": 0
              }
            },
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "submitted"
                  },
                  "message": {
                    "const": "análise recebida"
                  }
                }
              },
              {
                "properties": {
                  "status": {
                    "const": "processing"
                  },
                  "message": {
                    "const": "análise em processamento"
                  }
                }
              }
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "decision_id"
                  ]
                },
                {
                  "required": [
                    "outcome"
                  ]
                },
                {
                  "required": [
                    "decided_at"
                  ]
                },
                {
                  "required": [
                    "policy"
                  ]
                },
                {
                  "required": [
                    "approved_terms"
                  ]
                }
              ]
            }
          },
          {
            "title": "Decisão aprovada",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors",
              "approved_terms"
            ],
            "properties": {
              "status": {
                "const": "completed"
              },
              "outcome": {
                "const": "approve"
              },
              "message": {
                "const": "decisão aprovada"
              }
            }
          },
          {
            "title": "Decisão recusada",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors"
            ],
            "properties": {
              "status": {
                "const": "completed"
              },
              "outcome": {
                "const": "reject"
              },
              "message": {
                "const": "decisão recusada"
              }
            },
            "not": {
              "required": [
                "approved_terms"
              ]
            }
          },
          {
            "title": "Decisão aprovada com alterações",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors",
              "approved_terms"
            ],
            "properties": {
              "status": {
                "const": "completed"
              },
              "outcome": {
                "const": "approve_with_changes"
              },
              "message": {
                "const": "decisão aprovada com alterações"
              }
            }
          },
          {
            "title": "Dados adicionais necessários",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors"
            ],
            "properties": {
              "status": {
                "const": "requires_input"
              },
              "outcome": {
                "const": "request_more_data"
              },
              "message": {
                "const": "dados adicionais necessários"
              }
            },
            "not": {
              "required": [
                "approved_terms"
              ]
            }
          },
          {
            "title": "Decisão inconclusiva",
            "required": [
              "contract_version",
              "proposal_id",
              "decision_id",
              "status",
              "outcome",
              "decided_at",
              "product_type",
              "channel",
              "message",
              "correlation_id",
              "policy",
              "reason_codes",
              "factors"
            ],
            "properties": {
              "status": {
                "const": "unable_to_decide"
              },
              "outcome": {
                "const": "unable_to_decide"
              },
              "message": {
                "const": "decisão inconclusiva"
              }
            },
            "not": {
              "required": [
                "approved_terms"
              ]
            }
          }
        ]
      },
      "DecisionPolicyMetadata": {
        "type": "object",
        "required": [
          "policy_id",
          "policy_version_id",
          "policy_revision",
          "reason_code_catalog_version_id"
        ],
        "properties": {
          "policy_id": {
            "type": "string"
          },
          "policy_version_id": {
            "type": "string"
          },
          "policy_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reason_code_catalog_version_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ReasonCode": {
        "type": "object",
        "required": [
          "code",
          "title",
          "description",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ExplainableFactor": {
        "type": "object",
        "required": [
          "factor_id",
          "field",
          "title",
          "description",
          "required"
        ],
        "properties": {
          "factor_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ApprovedTerms": {
        "type": "object",
        "required": [
          "approved_amount_units",
          "approved_installments",
          "approved_term_days"
        ],
        "properties": {
          "approved_amount_units": {
            "type": "integer",
            "minimum": 0
          },
          "approved_installments": {
            "type": "integer",
            "minimum": 0
          },
          "approved_term_days": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "error_code": {
            "type": "string",
            "description": "Código público versionado, seguro e estável. decision_not_available também cobre inexistente, cross-tenant e permissão insuficiente quando a existência não puder ser revelada.",
            "enum": [
              "invalid_request",
              "decision_not_available",
              "decision_query_failed"
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensagem pública segura sem payload bruto ou detalhe técnico interno."
          },
          "correlation_id": {
            "type": "string",
            "description": "Correlation ID recebido na requisição para rastreabilidade."
          }
        },
        "additionalProperties": false,
        "description": "Erro público versionado e seguro para consulta de decisão/status."
      }
    },
    "examples": {
      "DecisionSubmittedExample": {
        "summary": "Status público pendente sem decisão final",
        "value": {
          "contract_version": "v1",
          "proposal_id": "proposal_personal_credit_001",
          "status": "submitted",
          "product_type": "personal_credit",
          "channel": "api",
          "message": "análise recebida",
          "correlation_id": "corr_contract_decision_001",
          "reason_codes": [],
          "factors": []
        }
      },
      "DecisionApprovedExample": {
        "summary": "Decisão final aprovada com termos aprovados minimizados",
        "value": {
          "contract_version": "v1",
          "proposal_id": "proposal_personal_credit_001",
          "decision_id": "decision_personal_credit_001",
          "status": "completed",
          "outcome": "approve",
          "decided_at": "2026-10-09T12:00:00+00:00",
          "product_type": "personal_credit",
          "channel": "api",
          "message": "decisão aprovada",
          "correlation_id": "corr_contract_decision_001",
          "policy": {
            "policy_id": "policy_credit_default",
            "policy_version_id": "policy_credit_default_v1",
            "policy_revision": 1,
            "reason_code_catalog_version_id": "reason_catalog_v1"
          },
          "reason_codes": [
            {
              "code": "rc_positive_capacity",
              "title": "Capacidade compatível",
              "description": "Indicadores agregados sustentam a aprovação solicitada.",
              "severity": "info"
            }
          ],
          "factors": [
            {
              "factor_id": "factor_declared_income_band",
              "field": "declared_income_band",
              "title": "Faixa de renda declarada",
              "description": "Faixa agregada utilizada na decisão explicável.",
              "required": true
            }
          ],
          "approved_terms": {
            "approved_amount_units": 500000,
            "approved_installments": 12,
            "approved_term_days": 365
          }
        }
      },
      "DecisionRejectedExample": {
        "summary": "Decisão final recusada sem termos aprovados",
        "value": {
          "contract_version": "v1",
          "proposal_id": "proposal_bnpl_001",
          "decision_id": "decision_bnpl_001",
          "status": "completed",
          "outcome": "reject",
          "decided_at": "2026-10-09T12:05:00+00:00",
          "product_type": "bnpl",
          "channel": "checkout",
          "message": "decisão recusada",
          "correlation_id": "corr_contract_decision_002",
          "policy": {
            "policy_id": "policy_bnpl_default",
            "policy_version_id": "policy_bnpl_default_v1",
            "policy_revision": 1,
            "reason_code_catalog_version_id": "reason_catalog_v1"
          },
          "reason_codes": [
            {
              "code": "rc_insufficient_score_band",
              "title": "Faixa de score insuficiente",
              "description": "Indicadores agregados ficaram abaixo do mínimo configurado.",
              "severity": "warning"
            }
          ],
          "factors": [
            {
              "factor_id": "factor_score_band",
              "field": "score_band",
              "title": "Faixa de score",
              "description": "Faixa agregada usada para explicar a recusa.",
              "required": true
            }
          ]
        }
      },
      "DecisionUnableToDecideExample": {
        "summary": "Decisão inconclusiva sem fila manual e sem termos aprovados",
        "value": {
          "contract_version": "v1",
          "proposal_id": "proposal_business_credit_001",
          "decision_id": "decision_business_credit_001",
          "status": "unable_to_decide",
          "outcome": "unable_to_decide",
          "decided_at": "2026-10-09T12:10:00+00:00",
          "product_type": "business_credit",
          "channel": "partner",
          "message": "decisão inconclusiva",
          "correlation_id": "corr_contract_decision_003",
          "policy": {
            "policy_id": "policy_business_credit_default",
            "policy_version_id": "policy_business_credit_default_v1",
            "policy_revision": 1,
            "reason_code_catalog_version_id": "reason_catalog_v1"
          },
          "reason_codes": [
            {
              "code": "rc_missing_governed_signal",
              "title": "Sinal governado indisponível",
              "description": "Sinais mínimos agregados não ficaram disponíveis para decisão automática.",
              "severity": "warning"
            }
          ],
          "factors": [
            {
              "factor_id": "factor_signal_availability",
              "field": "signal_availability",
              "title": "Disponibilidade de sinais",
              "description": "Disponibilidade agregada insuficiente para decisão determinística.",
              "required": true
            }
          ]
        }
      },
      "DecisionNotAvailableErrorExample": {
        "summary": "Erro público indistinguível para decisão indisponível",
        "value": {
          "error_code": "decision_not_available",
          "message": "decisão não disponível",
          "correlation_id": "corr_contract_decision_404"
        }
      },
      "DecisionInvalidRequestErrorExample": {
        "summary": "Erro público para requisição inválida",
        "value": {
          "error_code": "invalid_request",
          "message": "requisição inválida",
          "correlation_id": "corr_contract_decision_400"
        }
      },
      "DecisionQueryFailedErrorExample": {
        "summary": "Erro público para falha controlada na consulta de decisão",
        "value": {
          "error_code": "decision_query_failed",
          "message": "consulta de decisão indisponível",
          "correlation_id": "corr_contract_decision_500"
        }
      }
    }
  }
}
