  "webhooks": {
    "decisionNotification": {
      "post": {
        "summary": "Callback público assinado de decisão",
        "operationId": "receiveDecisionWebhook",
        "description": "Contrato da requisição enviada pelo CreditOS ao endpoint HTTPS configurado pelo cliente B2B.",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "schema": {
              "const": "application/json"
            }
          },
          {
            "name": "X-CreditOS-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-CreditOS-Event-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^evt_[a-f0-9]{32}$"
            }
          },
          {
            "name": "X-CreditOS-Event-Type",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "decision.status_changed",
                "decision.completed"
              ]
            }
          },
          {
            "name": "X-CreditOS-Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8
            }
          },
          {
            "name": "X-CreditOS-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^sha256=[a-f0-9]{64}$"
            }
          },
          {
            "name": "X-CreditOS-Signature-Algorithm",
            "in": "header",
            "required": true,
            "schema": {
              "const": "hmac_sha256"
            }
          },
          {
            "name": "X-CreditOS-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookCallbackPayload"
              },
              "examples": {
                "WebhookCallbackPayloadExample": {
                  "$ref": "#/components/examples/WebhookCallbackPayloadExample"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Callback aceito pelo cliente"
          },
          "400": {
            "description": "Callback rejeitado pelo cliente por contrato inválido"
          },
          "500": {
            "description": "Falha temporária do cliente; elegível a retry conforme política configurada"
          }
        }
      }
    }
  }
}
