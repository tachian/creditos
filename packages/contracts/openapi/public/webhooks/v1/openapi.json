{
  "openapi": "3.1.0",
  "info": {
    "title": "CreditOS Webhooks Public API Contract",
    "version": "v1",
    "description": "Contrato público versionado para configuração governada de webhooks por tenant e evento."
  },
  "x-creditos": {
    "owner": "Integration",
    "compatibility": "experimental",
    "breakingChangePolicy": "new-major-version-required",
    "lifecycle": "mvp-pre-production",
    "freezeTrigger": "first-external-client-integration",
    "deliveryScope": "Configuração pública e contrato de callback assinado; execução assíncrona, broker real, retry operacional e DLQ runtime pertencem às Stories 8.4 e 8.5."
  },
  "paths": {
    "/v1/webhooks/configurations": {
      "post": {
        "summary": "Configura webhook por tenant e eventos permitidos",
        "operationId": "configureWebhook",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookConfigurationRequest"
              },
              "examples": {
                "WebhookConfigurationRequestExample": {
                  "$ref": "#/components/examples/WebhookConfigurationRequestExample"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Configuração aceita",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookConfigurationResponse"
                },
                "examples": {
                  "WebhookConfigurationResponseExample": {
                    "$ref": "#/components/examples/WebhookConfigurationResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Configuração inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/WebhookInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/WebhookInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflito idempotente ou de configuração",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookConfigurationFailedErrorExample": {
                    "$ref": "#/components/examples/WebhookConfigurationFailedErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookConfigurationFailedErrorExample": {
                    "$ref": "#/components/examples/WebhookConfigurationFailedErrorExample"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Lista configurações de webhook do tenant autenticado",
        "operationId": "listWebhooks",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Configurações do tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookConfigurationListResponse"
                },
                "examples": {
                  "WebhookConfigurationListResponseExample": {
                    "$ref": "#/components/examples/WebhookConfigurationListResponseExample"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/WebhookInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/WebhookInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Configuração não disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookConfigurationNotAvailableErrorExample": {
                    "$ref": "#/components/examples/WebhookConfigurationNotAvailableErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookConfigurationFailedErrorExample": {
                    "$ref": "#/components/examples/WebhookConfigurationFailedErrorExample"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/configurations/{webhook_configuration_id}": {
      "patch": {
        "summary": "Desativa configuração de webhook",
        "operationId": "disableWebhookConfiguration",
        "parameters": [
          {
            "name": "webhook_configuration_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^wcfg_[a-z0-9_.:-]{3,160}$"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookStatusUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Configuração desativada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookConfigurationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/WebhookInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticação ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookInvalidRequestErrorExample": {
                    "$ref": "#/components/examples/WebhookInvalidRequestErrorExample"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflito idempotente ou de estado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookConfigurationFailedErrorExample": {
                    "$ref": "#/components/examples/WebhookConfigurationFailedErrorExample"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro controlado sem detalhe interno sensível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "WebhookConfigurationFailedErrorExample": {
                    "$ref": "#/components/examples/WebhookConfigurationFailedErrorExample"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "XCorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "XRequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "schemas": {
      "WebhookConfigurationRequest": {
        "type": "object",
        "required": [
          "endpoint_url",
          "events",
          "status",
          "signing",
          "retry_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "endpoint_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "decision.status_changed",
                "decision.completed"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled",
              "pending_verification"
            ]
          },
          "signing": {
            "$ref": "#/components/schemas/WebhookSigningConfiguration"
          },
          "retry_policy": {
            "$ref": "#/components/schemas/WebhookRetryPolicy"
          }
        }
      },
      "WebhookStatusUpdateRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "disabled"
            ]
          }
        }
      },
      "WebhookConfigurationListResponse": {
        "type": "object",
        "required": [
          "contract_version",
          "items",
          "correlation_id"
        ],
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookConfigurationResponse"
            }
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "WebhookConfigurationResponse": {
        "type": "object",
        "required": [
          "contract_version",
          "webhook_configuration_id",
          "endpoint_url",
          "events",
          "status",
          "signing",
          "retry_policy",
          "created_at",
          "updated_at",
          "correlation_id"
        ],
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "v1"
          },
          "webhook_configuration_id": {
            "type": "string",
            "pattern": "^wcfg_[a-z0-9_.:-]{3,160}$"
          },
          "endpoint_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "decision.status_changed",
                "decision.completed"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled",
              "pending_verification",
              "rejected"
            ]
          },
          "signing": {
            "$ref": "#/components/schemas/WebhookSigningConfiguration"
          },
          "retry_policy": {
            "$ref": "#/components/schemas/WebhookRetryPolicy"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "WebhookSigningConfiguration": {
        "type": "object",
        "required": [
          "algorithm",
          "signing_key_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": [
              "hmac_sha256"
            ]
          },
          "signing_key_ref": {
            "type": "string",
            "pattern": "^wkey_[a-z0-9_.:-]{3,160}$"
          }
        }
      },
      "WebhookRetryPolicy": {
        "type": "object",
        "required": [
          "strategy",
          "max_attempts",
          "initial_backoff_ms",
          "max_backoff_ms",
          "timeout_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "standard_exponential_backoff",
              "no_retry"
            ]
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "initial_backoff_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          },
          "max_backoff_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 500,
            "maximum": 30000
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error_code",
          "message",
          "correlation_id"
        ],
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "webhook_configuration_not_available",
              "webhook_configuration_failed"
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensagem pública segura, sem detalhes internos, endpoint inseguro bruto ou segredo."
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "WebhookCallbackPayload": {
        "type": "object",
        "required": [
          "contract_version",
          "event_id",
          "event_type",
          "proposal_id",
          "decision_status",
          "occurred_at",
          "correlation_id",
          "trace_id",
          "idempotency_key"
        ],
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "v1"
          },
          "event_id": {
            "type": "string",
            "pattern": "^evt_[a-f0-9]{32}$"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "decision.status_changed",
              "decision.completed"
            ]
          },
          "proposal_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "decision_status": {
            "type": "string",
            "enum": [
              "submitted",
              "processing",
              "completed",
              "requires_input",
              "unable_to_decide"
            ]
          },
          "decision_outcome": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "approve_with_changes",
              "request_more_data",
              "unable_to_decide"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8
          }
        },
        "oneOf": [
          {
            "title": "Status pré-decisão",
            "properties": {
              "event_type": {
                "const": "decision.status_changed"
              },
              "decision_status": {
                "enum": [
                  "submitted",
                  "processing"
                ]
              }
            },
            "not": {
              "required": [
                "decision_outcome"
              ]
            }
          },
          {
            "title": "Decisão final concluída",
            "required": [
              "decision_outcome"
            ],
            "properties": {
              "event_type": {
                "const": "decision.completed"
              },
              "decision_status": {
                "const": "completed"
              },
              "decision_outcome": {
                "enum": [
                  "approve",
                  "reject",
                  "approve_with_changes"
                ]
              }
            }
          },
          {
            "title": "Dados adicionais necessários",
            "required": [
              "decision_outcome"
            ],
            "properties": {
              "event_type": {
                "const": "decision.status_changed"
              },
              "decision_status": {
                "const": "requires_input"
              },
              "decision_outcome": {
                "const": "request_more_data"
              }
            }
          },
          {
            "title": "Decisão inconclusiva",
            "required": [
              "decision_outcome"
            ],
            "properties": {
              "event_type": {
                "const": "decision.completed"
              },
              "decision_status": {
                "const": "unable_to_decide"
              },
              "decision_outcome": {
                "const": "unable_to_decide"
              }
            }
          }
        ]
      },
      "WebhookDeliveryHeaders": {
        "type": "object",
        "required": [
          "Content-Type",
          "X-CreditOS-Correlation-Id",
          "X-CreditOS-Event-Id",
          "X-CreditOS-Event-Type",
          "X-CreditOS-Idempotency-Key",
          "X-CreditOS-Signature",
          "X-CreditOS-Signature-Algorithm",
          "X-CreditOS-Timestamp"
        ],
        "additionalProperties": false,
        "properties": {
          "Content-Type": {
            "const": "application/json"
          },
          "X-CreditOS-Correlation-Id": {
            "type": "string",
            "minLength": 1
          },
          "X-CreditOS-Event-Id": {
            "type": "string",
            "pattern": "^evt_[a-f0-9]{32}$"
          },
          "X-CreditOS-Event-Type": {
            "type": "string",
            "enum": [
              "decision.status_changed",
              "decision.completed"
            ]
          },
          "X-CreditOS-Idempotency-Key": {
            "type": "string",
            "minLength": 8
          },
          "X-CreditOS-Signature": {
            "type": "string",
            "pattern": "^sha256=[a-f0-9]{64}$"
          },
          "X-CreditOS-Signature-Algorithm": {
            "const": "hmac_sha256"
          },
          "X-CreditOS-Timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookDeliveryRetryMetadata": {
        "type": "object",
        "required": [
          "strategy",
          "attempt_count",
          "max_attempts",
          "initial_backoff_ms",
          "max_backoff_ms",
          "timeout_ms",
          "delivery_status",
          "failure_code",
          "next_attempt_at",
          "dlq_status"
        ],
        "additionalProperties": false,
        "properties": {
          "strategy": {
            "type": "string",
            "enum": [
              "standard_exponential_backoff",
              "no_retry"
            ]
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "initial_backoff_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          },
          "max_backoff_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 500,
            "maximum": 30000
          },
          "delivery_status": {
            "type": "string",
            "enum": [
              "retry_scheduled",
              "dlq_recorded"
            ]
          },
          "failure_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "next_attempt_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "dlq_status": {
            "type": "string",
            "enum": [
              "not_recorded",
              "recorded"
            ]
          }
        },
        "oneOf": [
          {
            "title": "Retry agendado",
            "properties": {
              "strategy": {
                "const": "standard_exponential_backoff"
              },
              "delivery_status": {
                "const": "retry_scheduled"
              },
              "dlq_status": {
                "const": "not_recorded"
              },
              "next_attempt_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          {
            "title": "DLQ registrada",
            "properties": {
              "strategy": {
                "const": "no_retry"
              },
              "attempt_count": {
                "const": 1
              },
              "max_attempts": {
                "const": 1
              },
              "delivery_status": {
                "const": "dlq_recorded"
              },
              "dlq_status": {
                "const": "recorded"
              },
              "next_attempt_at": {
                "type": "null"
              }
            }
          }
        ]
      }
    },
    "examples": {
      "WebhookConfigurationRequestExample": {
        "summary": "Configuração pública aceita",
        "value": {
          "endpoint_url": "https://client.example.com/creditos/webhooks/decision",
          "events": [
            "decision.status_changed",
            "decision.completed"
          ],
          "status": "active",
          "signing": {
            "algorithm": "hmac_sha256",
            "signing_key_ref": "wkey_public_contract_key"
          },
          "retry_policy": {
            "strategy": "standard_exponential_backoff",
            "max_attempts": 5,
            "initial_backoff_ms": 1000,
            "max_backoff_ms": 60000,
            "timeout_ms": 5000
          }
        }
      },
      "WebhookConfigurationResponseExample": {
        "summary": "Resposta pública de configuração",
        "value": {
          "contract_version": "v1",
          "webhook_configuration_id": "wcfg_public_contract_001",
          "endpoint_url": "https://client.example.com/creditos/webhooks/decision",
          "events": [
            "decision.status_changed",
            "decision.completed"
          ],
          "status": "active",
          "signing": {
            "algorithm": "hmac_sha256",
            "signing_key_ref": "wkey_public_contract_key"
