{
  "$id": "https://contracts.creditos.local/schemas/integration/v1/integration-dlq.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato canônico v1 para retry, DLQ e reprocessamento controlado de integração.",
  "examples": [
    {
      "adapter_id": "mock-credit-bureau-v1",
      "attempt_count": 3,
      "dlq_id": "idlq_dddddddddddddddddddddddddddddddd",
      "execution_id": "iexec_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "failure_class": "timeout",
      "failure_code": "synthetic_timeout",
      "integration_class": "credit_bureau",
      "job_id": "ijob_cccccccccccccccccccccccccccccccc",
      "reprocess_count": 0,
      "retry_delay_ms": 1000,
      "schema_version": "1.0"
    }
  ],
  "properties": {
    "adapter_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,80}$",
      "type": "string"
    },
    "attempt_count": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "dlq_id": {
      "pattern": "^idlq_[a-f0-9]{32}$",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^iexec_[a-f0-9]{32}$",
      "type": "string"
    },
    "failure_class": {
      "enum": [
        "recoverable",
        "non_recoverable",
        "timeout",
        "invalid_result"
      ],
      "type": "string"
    },
    "failure_code": {
      "pattern": "^[a-z][a-z0-9_]{2,80}$",
      "type": "string"
    },
    "integration_class": {
      "enum": [
        "kyc_kyb",
        "credit_bureau",
        "anti_fraud",
        "receivables"
      ],
      "type": "string"
    },
    "job_id": {
      "pattern": "^ijob_[a-f0-9]{32}$",
      "type": "string"
    },
    "reprocess_count": {
      "maximum": 10,
      "minimum": 0,
      "type": "integer"
    },
    "retry_delay_ms": {
      "maximum": 120000,
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "execution_id",
    "job_id",
    "dlq_id",
    "integration_class",
    "adapter_id",
    "failure_class",
    "failure_code",
    "attempt_count",
    "schema_version"
  ],
  "title": "CreditOS Integration DLQ Schema",
  "type": "object",
  "x-creditos": {
    "breakingChangePolicy": "new-major-version-required",
    "compatibility": "backward-compatible",
    "forbiddenFields": [
      "address",
      "attributes",
      "authorization",
      "cnpj",
      "cpf",
      "custom",
      "document",
      "email",
      "exception",
      "headers",
      "legal_name",
      "metadata",
      "name",
      "payload",
      "phone",
      "provider_payload",
      "provider_response",
      "raw_payload",
      "request_body",
      "response_body",
      "secret",
      "stack_trace",
      "street",
      "token"
    ],
    "invalidExamples": [
      {
        "adapter_id": "mock-credit-bureau-v1",
        "attempt_count": 3,
        "exception": "timeout from provider",
        "execution_id": "iexec_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "failure_class": "timeout",
        "failure_code": "synthetic_timeout",
        "integration_class": "credit_bureau",
        "job_id": "ijob_cccccccccccccccccccccccccccccccc",
        "schema_version": "1.0"
      }
    ],
    "owner": "Integration",
    "version": "v1"
  }
}
