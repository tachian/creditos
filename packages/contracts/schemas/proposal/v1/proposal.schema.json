        "fallback_action": "unable_to_decide"
      }
    }
  ],
  "x-creditos": {
    "version": "v1",
    "owner": "Proposal Intake",
    "compatibility": "backward-compatible",
    "breakingChangePolicy": "new-major-version-required",
    "productTypes": ["personal_credit", "bnpl", "business_credit", "receivables"],
    "forbiddenFields": [
      "idempotency_key",
      "selected_plan",
      "plan_id",
      "extra_data",
      "tenant_id",
      "raw_payload",
      "payload",
      "custom",
      "metadata",
      "attributes"
    ],
    "invalidExamples": [
      {
        "schema_version": "1.0",
        "external_proposal_id": "prop-invalid-product",
        "person_type": "PF",
        "product_type": "credit_card",
        "channel": "api",
        "operation": {"requested_terms": {"amount": 100000, "currency": "BRL"}},
        "borrower": {"document_type": "CPF", "document": "00000000191", "name": "Pessoa Exemplo"},
        "product_data": {"personal_credit": {}}
      },
      {
        "schema_version": "1.0",
        "external_proposal_id": "prop-invalid-plan",
        "person_type": "PF",
        "product_type": "personal_credit",
        "channel": "api",
