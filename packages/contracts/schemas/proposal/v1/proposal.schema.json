{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.creditos.local/schemas/proposal/v1/proposal.schema.json",
  "title": "CreditOS Proposal Canonical Schema",
  "description": "Contrato canônico público para submissão governada de propostas CPF/CNPJ dos produtos MVP.",
  "type": "object",
  "required": [
    "schema_version",
    "external_proposal_id",
    "person_type",
    "product_type",
    "channel",
    "operation",
    "borrower",
    "product_data"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "external_proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,119}$",
      "not": {
        "anyOf": [
          {"pattern": "^\\d{11}$"},
          {"pattern": "^\\d{14}$"},
          {"pattern": "^\\d{10,15}$"}
        ]
      },
      "description": "Identificador da proposta no cliente; não deve conter CPF, CNPJ, e-mail, telefone ou segredo."
    },
    "person_type": {"type": "string", "enum": ["PF", "PJ"]},
    "product_type": {
      "type": "string",
      "enum": ["personal_credit", "bnpl", "business_credit", "receivables"]
    },
    "channel": {
      "type": "string",
      "enum": ["api", "batch", "portal", "partner", "checkout", "backoffice"]
    },
    "operation": {"$ref": "#/$defs/operation"},
    "borrower": {"$ref": "#/$defs/borrower"},
    "participants": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/participant"},
      "default": []
    },
    "consents": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/consent"},
      "default": []
    },
    "provided_data": {"$ref": "#/$defs/provided_data"},
    "risk_context": {"$ref": "#/$defs/risk_context"},
    "product_data": {"$ref": "#/$defs/product_data"},
    "decision_options": {"$ref": "#/$defs/decision_options"},
    "callback": {"$ref": "#/$defs/callback"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["person_type"], "properties": {"person_type": {"const": "PF"}}},
      "then": {
        "properties": {
          "borrower": {
            "required": ["document_type", "document", "name"],
            "properties": {"document_type": {"const": "CPF"}, "document": {"pattern": "^\\d{11}$"}}
          }
        }
      }
    },
    {
      "if": {"required": ["person_type"], "properties": {"person_type": {"const": "PJ"}}},
      "then": {
        "properties": {
          "borrower": {
            "required": ["document_type", "document", "legal_name"],
            "properties": {"document_type": {"const": "CNPJ"}, "document": {"pattern": "^\\d{14}$"}}
          }
        }
      }
    },
    {
      "if": {"required": ["product_type"], "properties": {"product_type": {"const": "personal_credit"}}},
      "then": {"properties": {"product_data": {"required": ["personal_credit"]}}}
    },
    {
      "if": {"required": ["product_type"], "properties": {"product_type": {"const": "bnpl"}}},
      "then": {"properties": {"product_data": {"required": ["bnpl"]}}}
    },
    {
      "if": {"required": ["product_type"], "properties": {"product_type": {"const": "business_credit"}}},
      "then": {"properties": {"product_data": {"required": ["business_credit"]}}}
    },
    {
      "if": {"required": ["product_type"], "properties": {"product_type": {"const": "receivables"}}},
      "then": {"properties": {"product_data": {"required": ["receivables"]}}}
    }
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["requested_terms"],
      "properties": {
        "requested_terms": {"$ref": "#/$defs/requested_terms"}
      },
      "additionalProperties": false
    },
    "requested_terms": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000,
          "description": "Valor monetário em centavos para evitar ponto flutuante binário."
        },
        "currency": {"const": "BRL"},
        "installments": {"type": "integer", "minimum": 1},
        "down_payment": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "first_due_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "borrower": {
      "type": "object",
      "required": ["document_type", "document"],
      "properties": {
        "document_type": {"type": "string", "enum": ["CPF", "CNPJ"]},
        "document": {"type": "string", "pattern": "^(?:\\d{11}|\\d{14})$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "birth_date": {"type": "string", "format": "date"},
        "legal_name": {"type": "string", "minLength": 1, "maxLength": 180},
        "trade_name": {"type": "string", "minLength": 1, "maxLength": 180},
        "foundation_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "required": ["participant_ref", "role"],
      "properties": {
        "participant_ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "role": {
          "type": "string",
          "enum": [
            "legal_representative",
            "shareholder",
            "guarantor",
            "co_borrower",
            "merchant",
            "seller",
            "payer",
            "assignor",
            "employer",
            "beneficial_owner"
          ]
        },
        "person_type": {"type": "string", "enum": ["PF", "PJ"]},
        "document_type": {"type": "string", "enum": ["CPF", "CNPJ"]},
        "document": {"type": "string", "pattern": "^(?:\\d{11}|\\d{14})$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "legal_name": {"type": "string", "minLength": 1, "maxLength": 180},
        "relationship": {"type": "string", "minLength": 1, "maxLength": 80},
        "ownership_percentage": {"type": "integer", "minimum": 0, "maximum": 10000},
        "signature_required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"required": ["document_type"], "properties": {"document_type": {"const": "CPF"}}},
          "then": {"properties": {"document": {"pattern": "^\\d{11}$"}}}
        },
        {
          "if": {"required": ["document_type"], "properties": {"document_type": {"const": "CNPJ"}}},
          "then": {"properties": {"document": {"pattern": "^\\d{14}$"}}}
        },
        {
          "if": {"required": ["person_type"], "properties": {"person_type": {"const": "PF"}}},
          "then": {
            "required": ["document_type", "document", "name"],
            "properties": {"document_type": {"const": "CPF"}, "document": {"pattern": "^\\d{11}$"}}
          }
        },
        {
          "if": {"required": ["person_type"], "properties": {"person_type": {"const": "PJ"}}},
          "then": {
            "required": ["document_type", "document", "legal_name"],
            "properties": {"document_type": {"const": "CNPJ"}, "document": {"pattern": "^\\d{14}$"}}
          }
        },
        {
          "if": {
            "required": ["role"],
            "properties": {
              "role": {
                "enum": [
                  "legal_representative",
                  "shareholder",
                  "guarantor",
                  "co_borrower",
                  "payer",
                  "beneficial_owner"
                ]
              }
            }
          },
          "then": {"required": ["person_type", "document_type", "document"]}
        }
      ],
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "required": ["subject_ref", "purpose", "source"],
      "properties": {
        "subject_ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "basis": {
          "type": "string",
          "enum": [
            "consent",
            "contract_execution",
            "legal_obligation",
            "legitimate_interest",
            "credit_protection"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "credit_analysis",
            "risk_analysis",
            "fraud_prevention",
            "identity_validation",
            "open_finance_data_access",
            "audit"
          ]
        },
        "source": {
          "type": "string",
          "enum": ["customer", "open_finance", "bureau", "partner", "internal"]
        },
        "granted_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "reference_id": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "provided_data": {
      "type": "object",
      "properties": {
        "contact": {"$ref": "#/$defs/contact_data"},
        "address": {"$ref": "#/$defs/address_data"},
        "financial": {"$ref": "#/$defs/financial_data"},
        "relationship": {"$ref": "#/$defs/relationship_data"},
        "employment": {"$ref": "#/$defs/employment_data"},
        "banking": {"$ref": "#/$defs/banking_data"},
        "commerce": {"$ref": "#/$defs/commerce_data"},
        "documents": {"$ref": "#/$defs/document_references"}
      },
      "default": {},
      "additionalProperties": false
    },
    "contact_data": {
      "type": "object",
      "properties": {
        "email": {"type": "string", "format": "email"},
        "phone": {"type": "string", "minLength": 8, "maxLength": 32}
      },
      "additionalProperties": false
    },
    "address_data": {
      "type": "object",
      "properties": {
        "postal_code": {"type": "string", "minLength": 1, "maxLength": 16},
        "city": {"type": "string", "minLength": 1, "maxLength": 120},
        "state": {"type": "string", "minLength": 2, "maxLength": 2},
        "country": {"const": "BR"}
      },
      "additionalProperties": false
    },
    "financial_data": {
      "type": "object",
      "properties": {
        "declared_monthly_income": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "declared_monthly_revenue": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "declared_monthly_debt": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "declared_cash_flow": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "relationship_data": {
      "type": "object",
      "properties": {
        "relationship_months": {"type": "integer", "minimum": 0},
        "internal_score_reference": {"type": "string", "minLength": 1, "maxLength": 120},
        "days_past_due_last_12m": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "employment_data": {
      "type": "object",
      "properties": {
        "employment_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "occupation": {"type": "string", "minLength": 1, "maxLength": 120},
        "employer_ref": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    },
    "banking_data": {
      "type": "object",
      "properties": {
        "account_age_months": {"type": "integer", "minimum": 0},
        "bank_reference": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "commerce_data": {
      "type": "object",
      "properties": {
        "merchant_reference": {"type": "string", "minLength": 1, "maxLength": 120},
        "order_reference": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "document_references": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["document_ref", "document_type"],
        "properties": {
          "document_ref": {"type": "string", "minLength": 1, "maxLength": 120},
          "document_type": {"type": "string", "minLength": 1, "maxLength": 80},
          "issuer": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "additionalProperties": false
      },
      "default": []
    },
    "risk_context": {
      "type": "object",
      "properties": {
        "ip_address": {"type": "string", "minLength": 3, "maxLength": 45},
        "user_agent": {"type": "string", "minLength": 1, "maxLength": 512},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "geo": {"$ref": "#/$defs/geo_context"},
        "transaction": {"$ref": "#/$defs/transaction_context"},
        "customer_provided_signals": {"$ref": "#/$defs/customer_provided_signals"}
      },
      "default": {},
      "additionalProperties": false
    },
    "geo_context": {
      "type": "object",
      "properties": {
        "country": {"type": "string", "minLength": 2, "maxLength": 2},
        "state": {"type": "string", "minLength": 2, "maxLength": 2},
        "city": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "transaction_context": {
      "type": "object",
      "properties": {
        "transaction_reference": {"type": "string", "minLength": 1, "maxLength": 120},
        "attempt_number": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "customer_provided_signals": {
      "type": "object",
      "properties": {
        "email_age_days": {"type": "integer", "minimum": 0},
        "device_reputation": {"type": "string", "enum": ["unknown", "low", "medium", "high"]},
        "velocity_24h": {"type": "integer", "minimum": 0},
        "billing_shipping_match": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "product_data": {
      "type": "object",
      "properties": {
        "personal_credit": {"$ref": "#/$defs/personal_credit_data"},
        "bnpl": {"$ref": "#/$defs/bnpl_data"},
        "business_credit": {"$ref": "#/$defs/business_credit_data"},
        "receivables": {"$ref": "#/$defs/receivables_data"}
      },
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false
    },
    "personal_credit_data": {
      "type": "object",
      "properties": {
        "employment_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "occupation": {"type": "string", "minLength": 1, "maxLength": 120},
        "declared_monthly_income": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "declared_monthly_debt": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "income_source": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    },
    "bnpl_data": {
      "type": "object",
      "required": ["merchant_reference", "order_reference"],
      "properties": {
        "merchant_reference": {"type": "string", "minLength": 1, "maxLength": 120},
        "order_reference": {"type": "string", "minLength": 1, "maxLength": 120},
        "cart_items_count": {"type": "integer", "minimum": 1},
        "delivery_method": {"type": "string", "minLength": 1, "maxLength": 80},
        "shipping_address_ref": {"type": "string", "minLength": 1, "maxLength": 80}
      },
      "additionalProperties": false
    },
    "business_credit_data": {
      "type": "object",
      "properties": {
        "business_activity_code": {"type": "string", "minLength": 1, "maxLength": 32},
        "declared_monthly_revenue": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "declared_monthly_debt": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
        "company_age_months": {"type": "integer", "minimum": 0},
        "requested_collateral": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "receivables_data": {
      "type": "object",
      "required": ["receivables"],
      "properties": {
        "receivables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/receivable"}
        }
      },
      "additionalProperties": false
    },
    "receivable": {
      "type": "object",
      "required": ["external_receivable_id", "payer_ref", "face_value", "due_date"],
      "properties": {
        "external_receivable_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "payer_ref": {"type": "string", "minLength": 1, "maxLength": 80},
        "face_value": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
        "due_date": {"type": "string", "format": "date"},
        "document_number": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "decision_options": {
      "type": "object",
      "required": ["execution_mode", "review_strategy", "fallback_action"],
      "properties": {
        "execution_mode": {"type": "string", "enum": ["sync", "async"]},
        "review_strategy": {"type": "string", "enum": ["policy_only", "ai_advisory"]},
        "fallback_action": {
          "type": "string",
          "enum": ["request_more_data", "unable_to_decide", "reject_by_policy"]
        },
        "max_wait_ms": {"type": "integer", "minimum": 1, "maximum": 30000}
      },
      "additionalProperties": false
    },
    "callback": {
      "type": "object",
      "required": ["callback_profile_ref"],
      "properties": {
        "callback_profile_ref": {"type": "string", "minLength": 1, "maxLength": 120},
        "events": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 120},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "external_proposal_id": "prop-personal-001",
      "person_type": "PF",
      "product_type": "personal_credit",
      "channel": "api",
      "operation": {
        "requested_terms": {
          "amount": 500000,
          "currency": "BRL",
          "installments": 6,
          "down_payment": 0,
          "first_due_date": "2026-09-15"
        }
      },
      "borrower": {
        "document_type": "CPF",
        "document": "00000000191",
        "name": "Pessoa Exemplo",
        "birth_date": "1990-01-01"
      },
      "provided_data": {
        "financial": {
          "declared_monthly_income": 800000,
          "declared_monthly_debt": 120000
        }
      },
      "risk_context": {},
      "product_data": {
        "personal_credit": {
          "employment_type": "formal",
