      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Estado agregado de disponibilidade de bancos por serviço e pool lógico.\n\nPlaceholder: Depende de health checks reais de banco sem expor host, schema ou credenciais.",
      "fieldConfig": {
        "defaults": {
          "unit": "state"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (service, pool) (creditos_database_availability{environment=~\"$environment\",service=~\"$service\",pool=~\"$pool\"})",
          "legendFormat": "{{service}} {{pool}} availability",
          "refId": "A"
        }
      ],
      "title": "Disponibilidade de banco",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latência técnica agregada de operações de banco.\n\nPlaceholder: Depende de instrumentação agregada do adapter de persistência.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service, pool, le) (rate(creditos_database_operation_duration_bucket{environment=~\"$environment\",service=~\"$service\",pool=~\"$pool\"}[5m])))",
          "legendFormat": "{{service}} {{pool}} p95",
          "refId": "A"
        }
      ],
      "title": "Latência p95 de banco",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Uso agregado do pool de conexões por serviço.\n\nPlaceholder: Depende de métricas agregadas de pool sem labels de host ou conexão.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, pool) (creditos_database_connection_pool_usage_ratio{environment=~\"$environment\",service=~\"$service\",pool=~\"$pool\"})",
          "legendFormat": "{{service}} {{pool}} pool usage",
          "refId": "A"
        }
      ],
      "title": "Saturação de conexões",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Falhas técnicas agregadas de dependências de dados.\n\nPlaceholder: Depende de adapter real de persistência e classificação técnica segura.",
      "fieldConfig": {
        "defaults": {
          "unit": "events/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
