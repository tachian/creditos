      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, pool, status) (rate(creditos_database_operation_total{environment=~\"$environment\",service=~\"$service\",pool=~\"$pool\",status=~\"$status\"}[5m]))",
          "legendFormat": "{{service}} {{pool}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Erros de banco",
      "type": "timeseries"
    }
