      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, version, status) (rate(creditos_requests_total{environment=~\"$environment\",service=~\"$service\",version=~\"$version\",status=~\"error|failed\"}[5m]))",
          "legendFormat": "{{service}} {{operation}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Erro pós-deploy",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 por versão operacional.\n\nPlaceholder: A label version será populada quando release metadata estiver instrumentado.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
