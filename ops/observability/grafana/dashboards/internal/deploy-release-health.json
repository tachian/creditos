      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, version, release_ref) (creditos_release_info{environment=~\"$environment\",service=~\"$service\",version=~\"$version\"})",
          "legendFormat": "{{service}} {{version}} {{release_ref}}",
          "refId": "A"
        }
      ],
      "title": "Commit/digest publicado",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
