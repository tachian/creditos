      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service, version, le) (rate(creditos_request_duration_bucket{environment=~\"$environment\",service=~\"$service\",version=~\"$version\"}[5m])))",
