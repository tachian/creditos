      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service, destination, le) (rate(creditos_request_duration_bucket{environment=~\"$environment\",service=~\"$service\",operation_type=\"integration\",destination=~\"$destination\"}[5m])))",
          "legendFormat": "{{service}} {{operation}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Latência por adapter",
      "type": "timeseries"
    },
