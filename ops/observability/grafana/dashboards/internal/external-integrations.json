    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Falhas por classe técnica de integração.",
      "fieldConfig": {
        "defaults": {
          "unit": "events/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, integration_class, status) (rate(creditos_requests_total{environment=~\"$environment\",service=~\"$service\",operation_type=\"integration\",destination=~\"$destination\",product_type=~\"$product_type\",status=~\"failed|timeout|fallback\"}[5m]))",
          "legendFormat": "{{service}} {{operation}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Falhas por classe",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latência de adapters externos.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
